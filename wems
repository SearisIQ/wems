read_key() {
  local k r
  IFS= read -rsn1 k || { echo QUIT; return; }
  case "$k" in
    $'\x1b')
      IFS= read -rsn2 -t 1 r
      case "$r" in '[A') echo UP ;; '[B') echo DOWN ;; '[C') echo RIGHT ;; '[D') echo LEFT ;; *) echo QUIT ;; esac ;;
    '') echo ENTER ;;
    k | K) echo UP ;; j | J) echo DOWN ;; q | Q | $'\x7f' | $'\x08') echo QUIT ;;
    *) echo "$k" ;;
  esac
}

menu() {
  local title=$1; shift
  local items=("$@") n=$# sel=${MENU_START:-0} top=0 rows big i key lines lr=${MENU_LR:-0} keys
  MENU_START=0 MENU_LR=0
  keys="↑↓ Navigate  ⏎ Select  ⌫ Esc Back"; ((lr)) && keys="↑↓ Navigate  ←→ Change  ⏎ Select  ⌫ Esc Back"
  while :; do
    lines=$(tput lines); big=1; rows=$((lines - 13))
    ((n > rows)) && { big=0; rows=$((lines - 5)); }
    ((n > rows)) && rows=$((rows - 1))
    ((rows < 3)) && rows=3
    ((sel < top)) && top=$sel
    ((sel >= top + rows)) && top=$((sel - rows + 1))
    printf '\033[H\033[2J'; ((big)) && banner
    printf '  %s\n\n' "$title"
    for ((i = top; i < n && i < top + rows; i++)); do
      if ((i == sel)); then printf '  %s➤ %s%s\n' "$CYAN$BOLD" "${items[i]}" "$RST"
      else printf '    %s\n' "${items[i]}"; fi
    done
    ((n > rows)) && printf '    %s%d of %d%s\n' "$DIM" $((sel + 1)) "$n" "$RST"
    printf '\n  %s%s%s\n' "$DIM" "$keys" "$RST"
    key=$(read_key)
    case "$key" in
      UP) if ((sel > 0)); then sel=$((sel - 1)); else sel=$((n - 1)); fi ;;
      DOWN) sel=$(( (sel + 1) % n )) ;;
      ENTER | RIGHT) PICK=$sel MENU_DIR=1; return ;;
      LEFT) ((lr)) && { PICK=$sel MENU_DIR=-1; return; } ;;
      QUIT) PICK=-1; return ;;
      [1-9]) if ((key <= n)); then PICK=$((key - 1)); return; fi ;;
    esac
  done
}

screen() { printf '\033[H\033[2J'; banner; }

snap_items() {
  ITEMS=(); local f
  for f in "${SNAPS[@]}"; do ITEMS+=("$(snap_label "$f")"); done
}

status_line() {
  local total used free last=""
  read -r total used free <<<"$(disk_kb)"
  load_snaps
  if ((${#SNAPS[@]})); then local c; read -r c _ _ <<<"$(snap_meta "${SNAPS[0]}")"; last=" · last $(ago "$c")"; fi
  printf '%sFree %s%s of %s · %d snapshots%s · auto %s%s' "$DIM" "$RST$BOLD$(human "$free")$RST$DIM" "" \
    "$(human "$total")" "${#SNAPS[@]}" "$last" "$(auto_status)" "$RST"
}

tui_snapshot() {
  screen; printf '  %sSAVE SNAPSHOT%s\n\n' "$BOLD" "$RST"
  save_snapshot || { press_any_key; return; }
  printf '  %s✓ Saved%s  %s\n' "$GREEN" "$RST" "$(snap_label "$SAVED")"
  printf '\n  %sCome back after your disk fills up again and pick Compare.%s\n' "$DIM" "$RST"
  press_any_key
}

tui_compare() {
  load_snaps
  if ((${#SNAPS[@]} == 0)); then screen; echo "  No snapshots yet. Save one first, then compare later."; press_any_key; return; fi
  snap_items
  menu "${BOLD}COMPARE${RST}  ${DIM}what do you want to look at?${RST}" "Current system  ${DIM}(scans now, 1–2 min)${RST}" "${ITEMS[@]}"
  ((PICK < 0)) && return
  local first=$PICK newer older
  local others=() idx=() i
  for ((i = 0; i < ${#SNAPS[@]}; i++)); do ((i + 1 == first)) || { others+=("${ITEMS[i]}"); idx+=("$i"); }; done
  if ((${#others[@]} == 0)); then screen; echo "  You need a second snapshot to compare against."; press_any_key; return; fi
  menu "${BOLD}COMPARE${RST}  ${DIM}…against which snapshot?${RST}" "${others[@]}"
  ((PICK < 0)) && return
  older=${SNAPS[${idx[PICK]}]}
  screen
  CURRENT_SCAN=""
  if ((first == 0)); then scan_current || { press_any_key; return; }; newer=$CURRENT_SCAN
  else newer=${SNAPS[first - 1]}; fi
  show_page "$(compare "$older" "$newer")"
  ((first == 0)) && offer_save_current
}

tui_delete() {
  while :; do
    load_snaps
    if ((${#SNAPS[@]} == 0)); then screen; echo "  No snapshots to delete."; press_any_key; return; fi
    snap_items
    menu "${BOLD}DELETE SNAPSHOTS${RST}  ${DIM}$(du -sh "$SNAP_DIR" | awk '{print $1}') on disk${RST}" \
      "All snapshots (${#SNAPS[@]})" "All except the latest" "${ITEMS[@]}"
    ((PICK < 0)) && return
    local doomed=()
    case $PICK in
      0) doomed=("${SNAPS[@]}") ;;
      1) doomed=("${SNAPS[@]:1}") ;;
      *) doomed=("${SNAPS[PICK - 2]}") ;;
    esac
    if ((${#doomed[@]} == 0)); then continue; fi
    screen
    if confirm "Delete ${#doomed[@]} snapshot(s)? This cannot be undone."; then rm -f "${doomed[@]}"; fi
  done
}

tui_auto() {
  local cur; cur=$(auto_status)
  menu "${BOLD}AUTO SNAPSHOTS${RST}  ${DIM}currently $cur · a background job saves one on a schedule${RST}" \
    "Every hour" "Every 3 hours" "Every 6 hours" "Every 12 hours" "Off"
  ((PICK < 0)) && return
  screen
  case $PICK in 0) set_auto 1 ;; 1) set_auto 3 ;; 2) set_auto 6 ;; 3) set_auto 12 ;; 4) set_auto off ;; esac
  press_any_key
}

tui() {
  tput smcup; ALT_SCREEN=1
  tput civis
  [[ -f "$AI_FLAG" ]] || ask_ai
  MAIN_SEL=0
  local labels acts act
  while :; do
    labels=("Save snapshot      ${DIM}Record what's using space right now${RST}"
      "Compare            ${DIM}See what grew since a snapshot${RST}")
    acts=(snap compare)
    if ai_on; then
      labels+=("AI mode            ${DIM}Let an AI name what your biggest folders are${RST}")
      acts+=(ai)
    fi
    labels+=("Space hogs         ${DIM}Check the usual suspects${RST}"
      "Watch free space   ${DIM}Live ticker, catch it while it happens${RST}"
      "Auto snapshots     ${DIM}Save one every few hours ($(auto_status))${RST}"
      "Delete snapshots   ${DIM}Remove old snapshots${RST}"
      "Settings           ${DIM}Change how WEMS works${RST}"
      "Update             ${DIM}Get the newest version from GitHub${RST}"
      "Quit")
    acts+=(hogs watch auto delete settings update quit)
    MENU_START=$MAIN_SEL
    menu "$(status_line)" "${labels[@]}"
    MAIN_SEL=$PICK
    act=quit; ((PICK >= 0)) && act=${acts[PICK]}
    case $act in
      snap) tui_snapshot ;; compare) tui_compare ;; ai) tui_ai ;; hogs) screen; hogs ;; watch) watch_free ;;
      auto) tui_auto ;; delete) tui_delete ;; settings) tui_settings ;;
      update) screen; if do_update; then press_any_key; exec "${WEMS_BIN:-$HOME/.local/bin}/wems"; fi; press_any_key ;;
      *) printf '\033[H\033[2J'; break ;;
    esac
  done
}

usage() {
  banner
  cat <<EOF | if ai_on; then cat; else grep -vE 'wems ai |WEMS_AI_'; fi
  ${BOLD}Usage${RST}
    wems                   Open the menu
    wems snap              Save a snapshot
    wems list              List snapshots (1 = newest)
    wems diff [A] [B]      Compare two snapshots. A and B are numbers from
                           'wems list' or 'now'. Default: newest vs now
    wems ai                Let an AI name your biggest folders (settings from the menu)
    wems hogs              Sizes of the usual space hogs
    wems watch             Live free-space ticker
    wems auto <hours|off>  Save a snapshot every N hours in the background
    wems rm <N|all|old>    Delete snapshot N, all, or all but the newest
    wems update            Install the latest version
    wems uninstall         Remove wems (asks before deleting snapshots)

  ${BOLD}Settings${RST} ${DIM}(environment variables)${RST}
    WEMS_MIN_MB=$MIN_MB   WEMS_TOP=$TOP   WEMS_DEPTH=$DEPTH
    WEMS_AUTO_KEEP=$AUTO_KEEP   WEMS_HOME=$WEMS_HOME
    WEMS_AI_MODEL=<model>  WEMS_AI_MAX=$AI_MAX
EOF
}

resolve() {
  load_snaps
  if [[ "$1" =~ ^[0-9]+$ ]] && (($1 >= 1 && $1 <= ${#SNAPS[@]})); then echo "${SNAPS[$1 - 1]}"; return; fi
  [[ -f "$1" ]] && { echo "$1"; return; }
  echo "  No snapshot '$1'. See: wems list" >&2; return 1
}

case "${1:-}" in
  "") if [[ -t 0 && -t 1 ]]; then tui; else usage; fi ;;
  snap) if [[ "${2:-}" == "--auto" ]]; then save_snapshot auto; else save_snapshot && echo "  ${GREEN}✓ Saved${RST}  $(snap_label "$SAVED")"; fi ;;
  list)
    load_snaps
    ((${#SNAPS[@]})) || echo "  No snapshots yet. Run: wems snap"
    for ((i = 0; i < ${#SNAPS[@]}; i++)); do printf '  %s%2d%s  %s\n' "$BOLD" $((i + 1)) "$RST" "$(snap_label "${SNAPS[i]}")"; done ;;
  diff)
    load_snaps
    ((${#SNAPS[@]})) || { echo "  No snapshots yet. Run: wems snap"; exit 1; }
    a=$(resolve "${2:-1}") || exit 1
    if [[ "${3:-now}" == "now" ]]; then scan_current || exit 1; b=$CURRENT_SCAN; else b=$(resolve "$3") || exit 1; fi
    compare "$a" "$b" ;;
  hogs) hogs ;;
  ai) ai_on || { echo "  AI mode is off. Turn it on in wems → Settings."; exit 1; }
    ai_load; AI_SCOPE=${AI_SCOPE:-disk}; ai_run && ai_render "$AI_LAST" ;;
  watch) watch_free ;;
  auto) set_auto "${2:-}" ;;
  rm)
    load_snaps
    case "${2:-}" in
      all) rm -f "${SNAPS[@]}" && echo "  Deleted ${#SNAPS[@]} snapshot(s)" ;;
      old) ((${#SNAPS[@]} > 1)) && rm -f "${SNAPS[@]:1}"; echo "  Kept the newest snapshot" ;;
      *) f=$(resolve "${2:-x}") && rm -f "$f" && echo "  Deleted $(basename "$f")" ;;
    esac ;;
  update) do_update ;;
  uninstall) uninstall ;;
  -v | --version | version) echo "wems $VERSION" ;;
  -h | --help | help) usage ;;
  *) usage; exit 1 ;;
esac
